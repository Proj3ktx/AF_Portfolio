---
import LabDemo from "../components/LabDemo.astro";
import Mechanism from "../components/Mechanism.astro";
import ProjectStudies from "../components/ProjectStudies.astro";
import Section from "../components/Section.astro";
import Base from "../layouts/Base.astro";
import { href, site } from "../config/site";
import {
  activities,
  coursework,
  honors,
  projects,
  roles,
  schools,
  skillGroups,
  work,
} from "../content/portfolio";
---

<Base>
  <section class="hero">
    <div>
      <p class="eyebrow">
        <span>{site.focus}</span>
        <span>{site.school}</span>
      </p>
      <h1>Robotics and mechanical design.</h1>
      <p class="lede">
        I’m Ali Fakira, a junior studying Engineering Technology at Drexel University. I’m interested in robotics, automation, and mechanical design. I like working through a problem and testing ideas to see what I can improve. During my summer 2026 co-op in Drexel’s robotics lab, I worked on Python and ROS 2 simulation experiments and a two-arm mobile robot CAD design. This portfolio shows that work and what I learned along the way.
      </p>
      <ul class="facts">
        <li>{site.program}</li>
        <li>{site.graduation}</li>
      </ul>
    </div>
    <Mechanism />
  </section>

  <p class="status">
    <a href={href("/#work")}>
      <span class="dot"></span>
      {work.dates} · {work.org}
    </a>
  </p>

  <Section id={work.id} index={work.index} title={work.title} lede={work.lede}>
    <article class="case">
      <header class="case-banner">
        <div>
          <p class="kicker">{work.org}</p>
          <h3>{work.role}</h3>
        </div>
        <p class="meta">{work.place}<span>{work.dates}</span></p>
      </header>
      <ProjectStudies />
    </article>
  </Section>

  <Section
    id="lab"
    index="02"
    title="Lab files and design views"
    lede="The project work brought together CAD, code, recorded evidence, and technical documentation. Here is a closer look at the models and source files."
  >
    <LabDemo />
  </Section>

  <Section
    id="projects"
    index="03"
    title="Projects"
    lede="Coursework and technical projects that helped me build the skills I brought to the robotics lab."
  >
    <ol class="entries">
      {
        projects.map((project) => (
          <li>
            <div class="entry-title">
              <h3>{project.title}</h3>
              <p class="meta">{project.dates}</p>
            </div>
            <p>{project.summary}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section
    id="experience"
    index="04"
    title="Other experience"
    lede="My experience in IT, coaching, and customer service. Each role gave me practice solving problems and working with different people."
  >
    <ol class="entries">
      {
        roles.map((role) => (
          <li>
            <div class="entry-title">
              <h3>{role.title}</h3>
              <p class="meta">
                {role.org} · {role.place}
                <span>{role.dates}</span>
              </p>
            </div>
            <p>{role.summary}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="skills" index="05" title="Skills">
    <div class="skill-groups">
      {
        skillGroups.map((group) => (
          <article>
            <h3>{group.label}</h3>
            <ul class="tags">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </Section>

  <Section id="education" index="06" title="Education">
    <ol class="entries schools">
      {
        schools.map((school) => (
          <li>
            <div class="entry-title">
              <h3>{school.name}</h3>
              <p class="meta">{school.dates}</p>
            </div>
            {school.detail && <p>{school.detail}</p>}
          </li>
        ))
      }
    </ol>
    <div class="coursework">
      <h3>Relevant coursework</h3>
      <ul class="tags">
        {coursework.map((course) => <li>{course}</li>)}
      </ul>
    </div>
  </Section>

  <Section
    id="record"
    index="07"
    title="Leadership and activities"
    lede="Programs, teams, and leadership roles I took part in alongside school."
  >
    <div class="record">
      <article>
        <h3>Honors</h3>
        <ul class="plain">
          {honors.map((honor) => <li>{honor}</li>)}
        </ul>
      </article>
      <article>
        <h3>Activities</h3>
        <ul class="tags">
          {activities.map((activity) => <li>{activity}</li>)}
        </ul>
      </article>
    </div>
  </Section>
</Base>
