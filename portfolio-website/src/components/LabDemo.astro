---
import Code from "astro/components/Code.astro";
import { href } from "../config/site";
import { cadModules, cadViews, deliverables, labFiles, labGroups } from "../content/lab";
---

<div class="folders">
  <article>
    <p class="kicker">Documents</p>
    <h3>Lab handoff</h3>
    <ul class="plain">
      {deliverables.map((item) => <li>{item}</li>)}
    </ul>
  </article>
  <article>
    <p class="kicker">Code</p>
    <h3>ROS 2 simulation projects</h3>
    <p>
      These files cover the TurtleBot3 waypoint experiment and the later single-arm pick-and-drop lab. I used Python and ROS 2 for control, data logging, and reviewing the simulation results.
    </p>
  </article>
  <article>
    <p class="kicker">CAD · Revision B</p>
    <h3>Revision B design review</h3>
    <p>
      The two-arm robot handoff contains 18 modules and 401 solid bodies, with SolidWorks and STEP files for review. The views below show the layout. Hardware interfaces, structural loads, and full-motion clearances still need to be checked before fabrication.
    </p>
  </article>
</div>

<div class="cad-views">
  {
    cadViews.map((view) => (
      <figure>
        <img src={href(view.src)} alt={view.alt} width="900" height="700" />
        <figcaption>{view.caption}</figcaption>
      </figure>
    ))
  }
</div>
<ul class="tags cad-modules">
  {cadModules.map((name) => <li>{name}</li>)}
</ul>

<div class="lab-code-intro" id="lab-source">
  <h3>Code and experiment setup</h3>
  <p>
    ROS 2 connects the robot software, Gazebo runs the simulated world, and RViz displays the robot model and sensor data. These files show how I used those tools in the experiments.
  </p>
</div>

<div class="code-demo">
  <div class="code-nav" aria-label="Lab source files">
    {
      labGroups.map((group) => (
        <div class="code-group">
          <p class="kicker">{group}</p>
          {labFiles
            .filter((file) => file.group === group)
            .map((file) => (
              <>
                <input
                  class="code-pick"
                  type="radio"
                  name="lab-file"
                  id={`lab-${file.id}`}
                  checked={file.id === labFiles[0].id}
                />
                <label for={`lab-${file.id}`}>{file.name}</label>
              </>
            ))}
        </div>
      ))
    }
  </div>
  <div class="code-stage">
    {
      labFiles.map((file) => (
        <article class={`code-pane pane-${file.id}`}>
          <header>
            <p class="kicker">{file.path}</p>
            <p>{file.note}</p>
          </header>
          <Code code={file.source} lang={file.lang} theme="github-dark" />
        </article>
      ))
    }
  </div>
</div>
